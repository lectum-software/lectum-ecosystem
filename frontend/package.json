{
  "name": "frontend",
  "version": "0.1.126",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev --turbo",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test src/utils/public-policy.test.mjs src/utils/session-policy.test.mjs",
    "typecheck": "tsc --noEmit --pretty false",
    "biome:check": "biome check --error-on-warnings .",
    "biome:fix": "biome check --write .",
    "check": "pnpm biome:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "@hookform/resolvers": "^5.4.0",
