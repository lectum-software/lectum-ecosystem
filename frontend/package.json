    "@types/node": "^20",
    "@types/nprogress": "^0.2.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "pnpm": {
    "overrides": {
      "form-data": "4.0.6",
      "nanoid@<3.3.17": "3.3.17",
      "postcss": "8.5.26",
      "sharp": "0.35.3",
