    "@radix-ui/react-slot": "^1.2.4",
    "@reduxjs/toolkit": "^2.12.0",
    "@tanstack/react-query": "^5.101.0",
    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "js-cookie": "^3.0.8",
    "lucide-react": "^1.17.0",
    "next": "16.2.11",
    "next-themes": "^0.4.6",
    "nprogress": "^0.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.77.0",
    "react-redux": "^9.3.0",
    "socket.io-client": "^4.8.3",
