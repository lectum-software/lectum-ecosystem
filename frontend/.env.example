# =============================================================================
# Lectum frontend - variaveis realmente referenciadas
# =============================================================================
# Apenas variaveis NEXT_PUBLIC_* ficam disponiveis no bundle do navegador.
# Variaveis SENTRY_* abaixo sao exclusivas do build. Nunca coloque valores reais
# neste arquivo nem use NEXT_PUBLIC_* para segredos.

# -----------------------------------------------------------------------------
# Runtime Next.js
# -----------------------------------------------------------------------------
# Definido automaticamente pelo Next/plataforma. Nao cadastre NODE_ENV
# manualmente no Dokploy: o build de producao deve manter o valor `production`.
# NODE_ENV=development
# Definido internamente pelo Next para selecionar instrumentacao Node ou Edge.
# Nao cadastre manualmente no Dokploy.
NEXT_RUNTIME=

# -----------------------------------------------------------------------------
# URLs publicas do app e API
# -----------------------------------------------------------------------------
# URL canonica do frontend, usada em SEO, sitemap, Open Graph e links absolutos.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Alias/fallback legado para a URL canonica do frontend. Deixe vazio se usar SITE_URL.
NEXT_PUBLIC_WEB_URL=
# URL publica/base da API backend.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Endpoint publico que inicia o OAuth Google no backend.
NEXT_PUBLIC_LOGIN_URL=http://localhost:3001/api/public/google/login
# URL publica do painel administrativo. Opcional fora do fluxo "visualizar como";
# quando ausente, o retorno dessa visualizacao volta ao login do frontend.
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002

# -----------------------------------------------------------------------------
# Identificacao visual e metadados publicos
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SYSTEM_NAME=Lectum
NEXT_PUBLIC_SYSTEM_DESCRIPTION=Plataforma Lectum

# -----------------------------------------------------------------------------
# Cookies/client auth
# -----------------------------------------------------------------------------
# Nomes dos cookies/client storage usados pelo proxy, hooks e API client.
NEXT_PUBLIC_TOKEN_LOCAL=lectum.token
NEXT_PUBLIC_USER_LOCAL=lectum.user
NEXT_PUBLIC_COOKIE_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# next/image
# -----------------------------------------------------------------------------
# Hosts/URLs adicionais permitidos para next/image, separados por virgula.
# Ex.: https://pub-example.r2.dev,https://cdn.example.com
NEXT_PUBLIC_IMAGE_REMOTE_HOSTS=

# -----------------------------------------------------------------------------
# Compartilhamento social
# -----------------------------------------------------------------------------
# Ativa a geracao client-side do video com arte via MediaBunny. Use `false` para
# voltar ao exportador legado com MediaRecorder sem alterar backend/R2.
NEXT_PUBLIC_LECTUM_SHARE_MEDIABUNNY_ENABLED=true

# -----------------------------------------------------------------------------
# Mercado Pago Checkout Bricks (frontend-only/public)
# -----------------------------------------------------------------------------
# Em dev/homolog, sandbox usa a Public Key APP_USR-* da aplicacao criada dentro da
# mesma conta Mercado Pago vendedora de teste configurada no backend.
NEXT_PUBLIC_MERCADO_PAGO_ENV=sandbox
# Deve pertencer a mesma aplicacao do Access Token APP_USR-* configurado no backend.
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=
# Obrigatorio em sandbox: e-mail da conta Mercado Pago COMPRADORA de teste.
# Deve ser identico a MERCADO_PAGO_SANDBOX_PAYER_EMAIL no backend.
NEXT_PUBLIC_MERCADO_PAGO_SANDBOX_PAYER_EMAIL=

# -----------------------------------------------------------------------------
# Sentry (monitoramento de erros, ativado somente com DSN + ambiente validos)
# -----------------------------------------------------------------------------
# DSN publico do projeto Sentry exclusivo do frontend. Sem DSN ou ambiente,
# runtime, CSP e upload de source maps permanecem desabilitados.
NEXT_PUBLIC_SENTRY_DSN=
# Obrigatorio junto ao DSN. Use `homolog` ou `production` conforme o deploy.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# O upload e a release exigem tambem o trio build-time completo abaixo.
# Slugs usados somente no build para publicar source maps.
SENTRY_ORG=
SENTRY_PROJECT=
# Segredo exclusivo do build. Configure no cofre da plataforma, nunca no bundle.
SENTRY_AUTH_TOKEN=
