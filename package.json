{
  "name": "lectum-ecosystem",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "prepare": "lefthook install",
    "run": "pnpm dev",
    "check": "pnpm check:frontend && pnpm check:backend",
    "check:frontend": "pnpm --dir frontend check",
    "check:backend": "if [ -f backend/package.json ]; then pnpm --dir backend check; else echo \"backend ainda sem package.json; pulando checks.\"; fi",
    "commitlint": "commitlint",
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "pnpm --dir frontend exec next dev --webpack --port 3002",
    "dev:backend": "pnpm --dir backend dev"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "lefthook": "^2.1.9"
  }
}
