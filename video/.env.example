# Lectum Video Service - copie para .env apenas em desenvolvimento.
# Em deploy, configure tudo em Environment Settings/Secrets de runtime; não use Build-time Arguments.
NODE_ENV=development
HOST=0.0.0.0
PORT=3003

# O mesmo segredo deve ser usado somente pelos serviços autorizados. Mínimo de 32 caracteres.
VIDEO_SERVICE_API_KEY=replace-with-random-secret-at-least-32-chars
# Redis deve ficar em rede privada. Em produção, use autenticação e rediss:// quando disponível.
REDIS_URL=redis://default:replace-with-redis-password@redis:6379/0
# Volume persistente compartilhado por API e worker.
VIDEO_STORAGE_ROOT=/var/lib/lectum-video
VIDEO_REQUIRE_WORKER_READY=true

# Ingestão e capacidade
VIDEO_MAX_INPUT_MB=500
VIDEO_MAX_OUTPUT_MB=500
VIDEO_MAX_DURATION_SECONDS=1800
VIDEO_MAX_QUEUED_JOBS=100
VIDEO_MIN_FREE_SPACE_MB=1024
VIDEO_UPLOAD_REQUEST_TIMEOUT_MS=1800000
# Reserva atômica no Redis evita overcommit de disco entre uploads concorrentes.
VIDEO_STORAGE_RESERVATION_TTL_SECONDS=604800

# Worker e retry
VIDEO_WORKER_CONCURRENCY=1
VIDEO_JOB_ATTEMPTS=3
VIDEO_JOB_TIMEOUT_MS=7200000
VIDEO_CANCELLATION_POLL_MS=750
VIDEO_GRACEFUL_SHUTDOWN_MS=30000

# FFmpeg/ffprobe
VIDEO_FFMPEG_PATH=ffmpeg
VIDEO_FFPROBE_PATH=ffprobe
VIDEO_FFMPEG_PRESET=medium
VIDEO_FFMPEG_CRF=23
VIDEO_MAX_WIDTH=1080
VIDEO_MAX_HEIGHT=1920
VIDEO_MAX_FPS=30
VIDEO_AUDIO_BITRATE_KBPS=128

# Retenção e limpeza
VIDEO_OUTPUT_TTL_SECONDS=86400
VIDEO_STALE_INPUT_TTL_SECONDS=21600
VIDEO_CLEANUP_INTERVAL_SECONDS=900

# Usada somente pelo docker-compose local para proteger o Redis.
REDIS_PASSWORD=replace-with-redis-password

# Somente para `pnpm test:e2e` local; não cadastrar no deploy.
VIDEO_E2E_BASE_URL=http://127.0.0.1:3003
VIDEO_E2E_FILE=
VIDEO_E2E_CANCEL_FILE=
