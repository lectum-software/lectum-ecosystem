# =============================================================================
# Lectum admin - variaveis realmente referenciadas
# =============================================================================
# Apenas variaveis NEXT_PUBLIC_* ficam disponiveis no bundle do navegador.
# Nao coloque segredos neste arquivo nem em envs NEXT_PUBLIC_*.

# -----------------------------------------------------------------------------
# Runtime Next.js
# -----------------------------------------------------------------------------
# Definido automaticamente pelo Next/plataforma. Nao cadastre NODE_ENV
# manualmente no Dokploy: o build de producao deve manter o valor `production`.
# Interno e definido pelo Next. Mantenha vazio no exemplo; nao cadastre no ambiente.
NEXT_RUNTIME=

# -----------------------------------------------------------------------------
# URLs publicas do admin, frontend e API
# -----------------------------------------------------------------------------
# URL publica/base da API backend usada pelo admin.
NEXT_PUBLIC_API_URL=http://localhost:3001
# URL publica do frontend principal, usada para abrir perfis/conteudos publicados.
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# next/image
# -----------------------------------------------------------------------------
# Hosts/URLs adicionais permitidos para next/image, separados por virgula.
# Ex.: https://pub-example.r2.dev,https://cdn.example.com
NEXT_PUBLIC_IMAGE_REMOTE_HOSTS=

# -----------------------------------------------------------------------------
# Sentry - erros somente, sem PII
# -----------------------------------------------------------------------------
# DSN publico do projeto Sentry do Admin. Sem valor valido, o SDK permanece inativo.
NEXT_PUBLIC_SENTRY_DSN=
# Ambiente exibido no Sentry: development, homolog ou production. Obrigatorio junto ao DSN;
# se estiver vazio ou invalido, a integracao permanece desabilitada para evitar misturar ambientes.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# Variaveis privadas usadas somente durante o build para publicar source maps.
# O runtime continua funcional sem elas, mas as pilhas minificadas nao serao desofuscadas.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
