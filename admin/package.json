{
  "name": "admin",
  "version": "0.1.21",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --port 3002",
    "build": "next build --webpack && node scripts/sync-route-group-manifests.mjs",
    "start": "next start -p 3002",
    "lint": "eslint --max-warnings=0",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test src/lib/http-origin-policy.test.mjs src/lib/shared-helpers.test.mjs",
    "typecheck": "tsc --noEmit --pretty false",
    "biome:check": "biome check --error-on-warnings .",
    "biome:fix": "biome check --write .",
    "check": "pnpm biome:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-query": "^5.101.0",
    "axios": "^1.19.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.77.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "pnpm": {
    "overrides": {
      "form-data": "4.0.6",
      "nanoid@<3.3.17": "3.3.17",
      "postcss": "8.5.26",
      "sharp": "0.35.3",
      "ws": "8.21.0"
    }
  }
}
