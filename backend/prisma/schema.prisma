generator client {
  provider               = "prisma-client"
  output                 = "../src/external/generated/prisma"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = ""
}

datasource db {
  provider = "postgresql"
}

model user {
  id                                      String                        @id @default(cuid())
  deleted                                 Boolean                       @default(false)
  deletedAt                               DateTime?                     @map("deleted_at")
  updatedAt                               DateTime                      @default(now()) @updatedAt @map("updated_at")
  createdAt                               DateTime                      @default(now()) @map("created_at")
  name                                    String
  avatar                                  String?
  provider                                String                        @default("manual")
  role                                    String                        @default("paciente")
  email                                   String                        @unique
  password                                String?
  password_confirm                        String?
  active                                  Boolean                       @default(true)
  need_reset                              Boolean                       @default(false)
  confirmed                               Boolean                       @default(false)
  confirmed_date                          DateTime?
  has_seen_discover_psychologists_tip     Boolean                       @default(false)
  has_seen_psychologists_my_search_tip    Boolean                       @default(false)
  has_seen_psychologist_whatsapp_tip      Boolean                       @default(false)
  has_seen_psychologist_profile_video_tip Boolean                       @default(false)
  has_seen_psychologist_reply_tip         Boolean                       @default(false)
  has_seen_psychologist_original_post_tip Boolean                       @default(false)
  has_seen_community_post_tip             Boolean                       @default(false)
  recovery_code                           String?
  recovery_date                           DateTime?
  confirm_code                            String?
  confirm_date                            DateTime?
  user_tokens                             user_token[]                  @relation("user_token_user")
  user_backgrounds                        user_background[]             @relation("user_background_user")
  phone_verifications                     phone_verification[]          @relation("phone_verification_user")
  patient_profile                         patient_profile?              @relation("patient_profile_user")
  psychologist_profile                    psychologist_profile?         @relation("psychologist_profile_user")
  psychologist_specialties                psychologist_specialty[]      @relation("psychologist_specialty_psychologist")
  psychologist_services                   psychologist_service[]        @relation("psychologist_service_psychologist")
  psychologist_approaches                 psychologist_approach[]       @relation("psychologist_approach_psychologist")
  favorite_psychologists                  psychologist_favorite[]       @relation("psychologist_favorite_user")
  favorited_by_patients                   psychologist_favorite[]       @relation("psychologist_favorite_psychologist")
  followed_psychologists                  psychologist_follow[]         @relation("psychologist_follow_user")
  followed_by_patients                    psychologist_follow[]         @relation("psychologist_follow_psychologist")
  contact_requests                        contact_request[]             @relation("contact_request_user")
  received_contact_requests               contact_request[]             @relation("contact_request_psychologist")
  profile_view_events                     profile_view_event[]          @relation("profile_view_event_viewer")
  received_profile_view_events            profile_view_event[]          @relation("profile_view_event_psychologist")
  profile_video_watch_sessions            profile_video_watch_session[] @relation("profile_video_watch_session_viewer")
  received_profile_video_watch_sessions   profile_video_watch_session[] @relation("profile_video_watch_session_psychologist")
  professional_reviews                    professional_review[]         @relation("professional_review_author")
  received_reviews                        professional_review[]         @relation("professional_review_psychologist")
  community_suggestions                   community_suggestion[]        @relation("community_suggestion_user")
  community_members                       community_member[]            @relation("community_member_user")
  community_posts                         community_post[]              @relation("community_post_author")
  post_replies                            post_reply[]                  @relation("post_reply_author")
  post_votes                              post_vote[]                   @relation("post_vote_user")
  post_saves                              post_save[]                   @relation("post_save_user")
  post_shares                             post_share[]                  @relation("post_share_user")
  post_reply_saves                        post_reply_save[]             @relation("post_reply_save_user")
  post_notification_mutes                 post_notification_mute[]      @relation("post_notification_mute_user")
  post_reports                            post_report[]                 @relation("post_report_reporter")
  notification_subscriptions              notification_subscription[]   @relation("notification_subscription_user")
  visitor_locations                       visitor_location[]            @relation("visitor_location_user")
  billing_addresses                       billing_address[]             @relation("billing_address_user")
  payment_methods                         payment_method[]              @relation("payment_method_user")
  logs                                    log__user[]                   @relation("log__user_user")
  notifications                           notification[]                @relation("notifications")
  notification_preference                 notification_preference?      @relation("notification_preference_user")

  @@index([email, deleted])
  @@index([active, deleted])
  @@index([role, deleted])
  @@map("users")
}

model notification_preference {
  id        String    @id @default(cuid())
  deleted   Boolean   @default(false)
  deletedAt DateTime? @map("deleted_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user_id   String    @unique
  prefs     Json
  user      user      @relation("notification_preference_user", fields: [user_id], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model visitor_location {
  id         String    @id @default(cuid())
  deleted    Boolean   @default(false)
  deletedAt  DateTime? @map("deleted_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  visitor_id String    @map("visitor_id")
  session_id String?   @map("session_id")
  user_id    String?   @map("user_id")
  city       String?
  state      String?
  country    String?
  source     String    @default("ip")
  confidence Float?
  provider   String?
  user       user?     @relation("visitor_location_user", fields: [user_id], references: [id], onDelete: SetNull)

  @@index([visitor_id, createdAt])
  @@index([user_id, createdAt])
  @@index([city, state, country])
  @@map("visitor_locations")
}

model user_token {
  id        String    @id @default(cuid())
  deleted   Boolean   @default(false)
  deletedAt DateTime? @map("deleted_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user_id   String
  token     String?
  device_id String?
  user      user      @relation("user_token_user", fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, device_id])
  @@index([token])
  @@map("user_tokens")
}

model user_background {
  id        String    @id @default(cuid())
  deleted   Boolean   @default(false)
  deletedAt DateTime? @map("deleted_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user_id   String
  type      String
  data      Json?
  device_id String?
  user      user      @relation("user_background_user", fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, type])
  @@map("user_backgrounds")
}

model phone_verification {
  id                  String    @id @default(cuid())
  deleted             Boolean   @default(false)
  deletedAt           DateTime? @map("deleted_at")
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  user_id             String
  phone               String
  purpose             String    @default("psychologist_whatsapp")
  provider            String    @default("twilio")
  provider_message_id String?
  code_hash           String
  expires_at          DateTime
  attempts            Int       @default(0)
  sent_at             DateTime  @default(now())
  verified_at         DateTime?
  user                user      @relation("phone_verification_user", fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, purpose, createdAt])
  @@index([phone, purpose])
  @@map("phone_verifications")
}

model patient_profile {
  id                      String    @id @default(cuid())
  deleted                 Boolean   @default(false)
  deletedAt               DateTime? @map("deleted_at")
  updatedAt               DateTime  @default(now()) @updatedAt @map("updated_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  user_id                 String    @unique
  goal                    String?
  gender                  String?
  birthdate               DateTime?
  phone                   String?
  bio                     String?
  onboarding_completed_at DateTime?
  user                    user      @relation("patient_profile_user", fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("patient_profiles")
}

model psychologist_profile {
  id                              String                        @id @default(cuid())
  deleted                         Boolean                       @default(false)
  deletedAt                       DateTime?                     @map("deleted_at")
  updatedAt                       DateTime                      @default(now()) @updatedAt @map("updated_at")
  createdAt                       DateTime                      @default(now()) @map("created_at")
  user_id                         String                        @unique
  headline                        String?
  bio                             String?
  cover_image_url                 String?                       @map("cover_image_url")
  video_url                       String?
  video_cover_url                 String?                       @map("video_cover_url")
  cpf                             String?
  crp                             String?
  crp_registration_date           DateTime?                     @map("crp_registration_date")
  gender                          String?
  race_color                      String?                       @map("race_color")
  religion                        String?
  target_audience                 Json?                         @map("target_audience")
  discount_first_session          Boolean                       @default(false) @map("discount_first_session")
  social_value                    Boolean                       @default(false) @map("social_value")
  accepts_insurance               Boolean                       @default(false) @map("accepts_insurance")
  show_experience_tag             Boolean                       @default(true) @map("show_experience_tag")
  academic_title                  String?                       @map("academic_title")
  academic_institution            String?                       @map("academic_institution")
  academic_graduation_year        String?                       @map("academic_graduation_year")
  academic_formations             Json?                         @map("academic_formations")
  available_days                  Json?                         @map("available_days")
  professional_address_street     String?                       @map("professional_address_street")
  professional_address_number     String?                       @map("professional_address_number")
  professional_address_complement String?                       @map("professional_address_complement")
  professional_address_district   String?                       @map("professional_address_district")
  professional_address_zip        String?                       @map("professional_address_zip")
  professional_address_city       String?                       @map("professional_address_city")
  professional_address_state      String?                       @map("professional_address_state")
  crp_status                      String                        @default("pendente")
  cfp_verified_at                 DateTime?
  whatsapp                        String?
  whatsapp_verified_at            DateTime?
  languages                       Json?
  modality                        String?
  rating_avg                      Int                           @default(0)
  rating_count                    Int                           @default(0)
  published                       Boolean                       @default(false)
  user                            user                          @relation("psychologist_profile_user", fields: [user_id], references: [id], onDelete: Cascade)
  subscriptions                   professional_subscription[]   @relation("professional_subscription_psychologist")
  registry_checks                 professional_registry_check[] @relation("professional_registry_check_psychologist")

  @@index([user_id])
  @@index([published, deleted])
  @@index([published, deleted, cfp_verified_at])
  @@map("psychologist_profiles")
}

model professional_registry_check {
  id              String               @id @default(cuid())
  deleted         Boolean              @default(false)
  deletedAt       DateTime?            @map("deleted_at")
  updatedAt       DateTime             @default(now()) @updatedAt @map("updated_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  psychologist_id String
  provider        String               @default("infosimples")
  cpf             String?
  registro        String?
  uf              String?
  found           Boolean              @default(false)
  raw             Json?
  checked_at      DateTime             @default(now())
  psychologist    psychologist_profile @relation("professional_registry_check_psychologist", fields: [psychologist_id], references: [id], onDelete: Cascade)

  @@index([psychologist_id, checked_at])
  @@index([cpf])
  @@map("professional_registry_checks")
}

model specialty {
  id                       String                   @id @default(cuid())
  deleted                  Boolean                  @default(false)
  deletedAt                DateTime?                @map("deleted_at")
  updatedAt                DateTime                 @default(now()) @updatedAt @map("updated_at")
  createdAt                DateTime                 @default(now()) @map("created_at")
  name                     String
  slug                     String                   @unique
  active                   Boolean                  @default(true)
  psychologist_specialties psychologist_specialty[] @relation("psychologist_specialty_specialty")

  @@index([slug, active])
  @@index([active, deleted])
  @@map("specialties")
}

model service {
  id                    String                 @id @default(cuid())
  deleted               Boolean                @default(false)
  deletedAt             DateTime?              @map("deleted_at")
  updatedAt             DateTime               @default(now()) @updatedAt @map("updated_at")
  createdAt             DateTime               @default(now()) @map("created_at")
  name                  String
  slug                  String                 @unique
  active                Boolean                @default(true)
  psychologist_services psychologist_service[] @relation("psychologist_service_service")

  @@index([slug, active])
  @@index([active, deleted])
  @@map("services")
}

model approach {
  id                      String                  @id @default(cuid())
  deleted                 Boolean                 @default(false)
  deletedAt               DateTime?               @map("deleted_at")
  updatedAt               DateTime                @default(now()) @updatedAt @map("updated_at")
  createdAt               DateTime                @default(now()) @map("created_at")
  name                    String
  slug                    String                  @unique
  active                  Boolean                 @default(true)
  psychologist_approaches psychologist_approach[] @relation("psychologist_approach_approach")

  @@index([slug, active])
  @@index([active, deleted])
  @@map("approaches")
}

model psychologist_specialty {
  id              String    @id @default(cuid())
  deleted         Boolean   @default(false)
  deletedAt       DateTime? @map("deleted_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  psychologist_id String
  specialty_id    String
  psychologist    user      @relation("psychologist_specialty_psychologist", fields: [psychologist_id], references: [id], onDelete: Cascade)
  specialty       specialty @relation("psychologist_specialty_specialty", fields: [specialty_id], references: [id], onDelete: Cascade)

  @@unique([psychologist_id, specialty_id])
  @@index([psychologist_id])
  @@index([specialty_id])
  @@map("psychologist_specialties")
}

model psychologist_service {
  id              String    @id @default(cuid())
  deleted         Boolean   @default(false)
  deletedAt       DateTime? @map("deleted_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  psychologist_id String
  service_id      String
  psychologist    user      @relation("psychologist_service_psychologist", fields: [psychologist_id], references: [id], onDelete: Cascade)
  service         service   @relation("psychologist_service_service", fields: [service_id], references: [id], onDelete: Cascade)

  @@unique([psychologist_id, service_id])
  @@index([psychologist_id])
  @@index([service_id])
  @@map("psychologist_services")
}

model psychologist_approach {
  id              String    @id @default(cuid())
  deleted         Boolean   @default(false)
  deletedAt       DateTime? @map("deleted_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  psychologist_id String
  approach_id     String
  psychologist    user      @relation("psychologist_approach_psychologist", fields: [psychologist_id], references: [id], onDelete: Cascade)
  approach        approach  @relation("psychologist_approach_approach", fields: [approach_id], references: [id], onDelete: Cascade)

  @@unique([psychologist_id, approach_id])
  @@index([psychologist_id])
  @@index([approach_id])
  @@map("psychologist_approaches")
}

model psychologist_favorite {
  id              String    @id @default(cuid())
  deleted         Boolean   @default(false)
  deletedAt       DateTime? @map("deleted_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  user_id         String
  psychologist_id String
  user            user      @relation("psychologist_favorite_user", fields: [user_id], references: [id], onDelete: Cascade)
  psychologist    user      @relation("psychologist_favorite_psychologist", fields: [psychologist_id], references: [id], onDelete: Cascade)

  @@unique([user_id, psychologist_id])
  @@index([user_id, deleted])
  @@index([psychologist_id])
  @@map("psychologist_favorites")
}

model psychologist_follow {
  id              String    @id @default(cuid())
  deleted         Boolean   @default(false)
  deletedAt       DateTime? @map("deleted_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  user_id         String
  psychologist_id String
  user            user      @relation("psychologist_follow_user", fields: [user_id], references: [id], onDelete: Cascade)
  psychologist    user      @relation("psychologist_follow_psychologist", fields: [psychologist_id], references: [id], onDelete: Cascade)

  @@unique([user_id, psychologist_id])
  @@index([user_id, deleted])
  @@index([psychologist_id])
  @@map("psychologist_follows")
}

model subscription_plan {
  id              String                      @id @default(cuid())
  deleted         Boolean                     @default(false)
  deletedAt       DateTime?                   @map("deleted_at")
  updatedAt       DateTime                    @default(now()) @updatedAt @map("updated_at")
  createdAt       DateTime                    @default(now()) @map("created_at")
  slug            String                      @unique
  name            String
  price_cents     Int                         @default(0)
  interval        String                      @default("month")
  features        Json?
  active          Boolean                     @default(true)
  gateway_plan_id String?
  subscriptions   professional_subscription[] @relation("professional_subscription_plan")

  @@index([active, deleted])
  @@index([gateway_plan_id])
  @@map("subscription_plans")
}

model professional_subscription {
  id                      String               @id @default(cuid())
  deleted                 Boolean              @default(false)
  deletedAt               DateTime?            @map("deleted_at")
  updatedAt               DateTime             @default(now()) @updatedAt @map("updated_at")
  createdAt               DateTime             @default(now()) @map("created_at")
  psychologist_id         String
  plan_id                 String
  status                  String               @default("inativa")
  source                  String               @default("legacy")
  gateway                 String?
  gateway_subscription_id String?
  current_period_end      DateTime?
  grant_reason            String?
  grant_notes             String?
  granted_by              String?
  grant_started_at        DateTime?
  psychologist            psychologist_profile @relation("professional_subscription_psychologist", fields: [psychologist_id], references: [id], onDelete: Cascade)
  plan                    subscription_plan    @relation("professional_subscription_plan", fields: [plan_id], references: [id])

  @@index([psychologist_id, status])
  @@index([plan_id])
  @@index([source, status])
  @@index([status, current_period_end])
  @@map("professional_subscriptions")
}

model billing_address {
  id         String    @id @default(cuid())
  deleted    Boolean   @default(false)
  deletedAt  DateTime? @map("deleted_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user_id    String
  zip        String
  street     String
  number     String
  complement String?
  district   String
  city       String
  state      String
  user       user      @relation("billing_address_user", fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("billing_addresses")
}

model payment_event {
  id          String    @id @default(cuid())
  deleted     Boolean   @default(false)
  deletedAt   DateTime? @map("deleted_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  gateway     String
  external_id String
  type        String
  payload     Json

  @@unique([gateway, external_id])
  @@map("payment_events")
}

model payment_method {
  id            String    @id @default(cuid())
  deleted       Boolean   @default(false)
  deletedAt     DateTime? @map("deleted_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  user_id       String
  gateway       String
  gateway_token String
  brand         String?
  last4         String?
  exp_month     Int?
  exp_year      Int?
  user          user      @relation("payment_method_user", fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([user_id, gateway])
  @@map("payment_methods")
}

model contact_request {
  id              String    @id @default(cuid())
  deleted         Boolean   @default(false)
  deletedAt       DateTime? @map("deleted_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  user_id         String?
  psychologist_id String
  channel         String    @default("whatsapp")
  user            user?     @relation("contact_request_user", fields: [user_id], references: [id], onDelete: SetNull)
  psychologist    user      @relation("contact_request_psychologist", fields: [psychologist_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([psychologist_id, createdAt])
  @@map("contact_requests")
}

model profile_view_event {
  id              String    @id @default(cuid())
  deleted         Boolean   @default(false)
  deletedAt       DateTime? @map("deleted_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  psychologist_id String
  viewer_id       String?
  device_id       String?
  source          String    @default("profile_page")
  psychologist    user      @relation("profile_view_event_psychologist", fields: [psychologist_id], references: [id], onDelete: Cascade)
  viewer          user?     @relation("profile_view_event_viewer", fields: [viewer_id], references: [id], onDelete: SetNull)

  @@index([psychologist_id, createdAt])
  @@index([viewer_id, createdAt])
  @@index([device_id, createdAt])
  @@map("profile_view_events")
}

model profile_video_watch_session {
  id                   String    @id @default(cuid())
  deleted              Boolean   @default(false)
  deletedAt            DateTime? @map("deleted_at")
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  psychologist_id      String
  viewer_id            String?
  session_key          String
  video_url            String?
  duration_seconds     Int       @default(0)
  watched_seconds      Int       @default(0)
  max_position_seconds Int       @default(0)
  replay_count         Int       @default(0)
  completed            Boolean   @default(false)
  milestone_25         Boolean   @default(false)
  milestone_50         Boolean   @default(false)
  milestone_75         Boolean   @default(false)
  milestone_100        Boolean   @default(false)
  retention_buckets    Json?     @map("retention_buckets")
  last_event_at        DateTime  @default(now()) @map("last_event_at")
  psychologist         user      @relation("profile_video_watch_session_psychologist", fields: [psychologist_id], references: [id], onDelete: Cascade)
  viewer               user?     @relation("profile_video_watch_session_viewer", fields: [viewer_id], references: [id], onDelete: SetNull)

  @@unique([psychologist_id, session_key])
  @@index([psychologist_id, createdAt])
  @@index([psychologist_id, last_event_at])
  @@index([viewer_id, createdAt])
  @@map("profile_video_watch_sessions")
}

model professional_review {
  id              String    @id @default(cuid())
  deleted         Boolean   @default(false)
  deletedAt       DateTime? @map("deleted_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  psychologist_id String
  author_id       String
  rating          Int
  comment         String?
  response        String?
  responded_at    DateTime?
  status          String    @default("publicada")
  psychologist    user      @relation("professional_review_psychologist", fields: [psychologist_id], references: [id], onDelete: Cascade)
  author          user      @relation("professional_review_author", fields: [author_id], references: [id], onDelete: Cascade)

  @@unique([psychologist_id, author_id])
  @@index([psychologist_id, status])
  @@index([author_id])
  @@map("professional_reviews")
}

model community {
  id                        String             @id @default(cuid())
  deleted                   Boolean            @default(false)
  deletedAt                 DateTime?          @map("deleted_at")
  updatedAt                 DateTime           @default(now()) @updatedAt @map("updated_at")
  createdAt                 DateTime           @default(now()) @map("created_at")
  name                      String
  slug                      String             @unique
  description               String?
  category                  String?
  members_count             Int                @default(0)
  avatar_url                String?            @map("avatar_url")
  visual_primary_color      String?            @map("visual_primary_color")
  visual_primary_dark_color String?            @map("visual_primary_dark_color")
  visual_soft_color         String?            @map("visual_soft_color")
  visual_text_color         String?            @map("visual_text_color")
  visual_gradient_color     String?            @map("visual_gradient_color")
  members                   community_member[] @relation("community_member_community")
  posts                     community_post[]   @relation("community_post_community")

  @@index([slug])
  @@index([category, deleted])
  @@map("communities")
}

model community_member {
  id           String    @id @default(cuid())
  deleted      Boolean   @default(false)
  deletedAt    DateTime? @map("deleted_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  community_id String
  user_id      String
  community    community @relation("community_member_community", fields: [community_id], references: [id], onDelete: Cascade)
  user         user      @relation("community_member_user", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([community_id, user_id])
  @@index([user_id])
  @@index([community_id, deleted])
  @@map("community_members")
}

model community_suggestion {
  id        String    @id @default(cuid())
  deleted   Boolean   @default(false)
  deletedAt DateTime? @map("deleted_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user_id   String
  theme     String
  status    String    @default("pendente")
  user      user      @relation("community_suggestion_user", fields: [user_id], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("community_suggestions")
}

model community_post {
  id                 String                   @id @default(cuid())
  deleted            Boolean                  @default(false)
  deletedAt          DateTime?                @map("deleted_at")
  updatedAt          DateTime                 @default(now()) @updatedAt @map("updated_at")
  createdAt          DateTime                 @default(now()) @map("created_at")
  edited_at          DateTime?
  community_id       String
  author_id          String
  title              String
  content            String
  media_url          String?
  media_type         String?
  anonymous          Boolean                  @default(true)
  status             String                   @default("publicado")
  upvotes_count      Int                      @default(0)
  downvotes_count    Int                      @default(0)
  replies_count      Int                      @default(0)
  saves_count        Int                      @default(0)
  community          community                @relation("community_post_community", fields: [community_id], references: [id], onDelete: Cascade)
  author             user                     @relation("community_post_author", fields: [author_id], references: [id], onDelete: Cascade)
  media_items        community_post_media[]   @relation("community_post_media_post")
  replies            post_reply[]             @relation("post_reply_post")
  votes              post_vote[]              @relation("post_vote_post")
  saves              post_save[]              @relation("post_save_post")
  shares             post_share[]             @relation("post_share_post")
  notification_mutes post_notification_mute[] @relation("post_notification_mute_post")
  reports            post_report[]            @relation("post_report_post")

  @@index([community_id, status, createdAt])
  @@index([author_id])
  @@index([author_id, status, createdAt])
  @@map("community_posts")
}

model community_post_media {
  id         String         @id @default(cuid())
  deleted    Boolean        @default(false)
  deletedAt  DateTime?      @map("deleted_at")
  updatedAt  DateTime       @default(now()) @updatedAt @map("updated_at")
  createdAt  DateTime       @default(now()) @map("created_at")
  post_id    String
  media_url  String
  media_type String
  position   Int            @default(0)
  post       community_post @relation("community_post_media_post", fields: [post_id], references: [id], onDelete: Cascade)

  @@index([post_id, position])
  @@map("community_post_media")
}

model post_reply {
  id              String            @id @default(cuid())
  deleted         Boolean           @default(false)
  deletedAt       DateTime?         @map("deleted_at")
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  edited_at       DateTime?
  post_id         String
  author_id       String
  parent_reply_id String?
  title           String?
  content         String
  media_url       String?
  media_type      String?
  upvotes_count   Int               @default(0)
  downvotes_count Int               @default(0)
  post            community_post    @relation("post_reply_post", fields: [post_id], references: [id], onDelete: Cascade)
  author          user              @relation("post_reply_author", fields: [author_id], references: [id], onDelete: Cascade)
  parent_reply    post_reply?       @relation("post_reply_thread", fields: [parent_reply_id], references: [id], onDelete: Cascade)
  replies         post_reply[]      @relation("post_reply_thread")
  votes           post_vote[]       @relation("post_vote_reply")
  shares          post_share[]      @relation("post_share_reply")
  saves           post_reply_save[] @relation("post_reply_save_reply")
  reports         post_report[]     @relation("post_report_reply")

  @@index([post_id, parent_reply_id, createdAt])
  @@index([author_id])
  @@map("post_replies")
}

model post_vote {
  id        String          @id @default(cuid())
  deleted   Boolean         @default(false)
  deletedAt DateTime?       @map("deleted_at")
  updatedAt DateTime        @default(now()) @updatedAt @map("updated_at")
  createdAt DateTime        @default(now()) @map("created_at")
  user_id   String
  post_id   String?
  reply_id  String?
  value     Int
  user      user            @relation("post_vote_user", fields: [user_id], references: [id], onDelete: Cascade)
  post      community_post? @relation("post_vote_post", fields: [post_id], references: [id], onDelete: Cascade)
  reply     post_reply?     @relation("post_vote_reply", fields: [reply_id], references: [id], onDelete: Cascade)

  @@unique([user_id, post_id])
  @@unique([user_id, reply_id])
  @@index([post_id])
  @@index([reply_id])
  @@map("post_votes")
}

model post_save {
  id        String         @id @default(cuid())
  deleted   Boolean        @default(false)
  deletedAt DateTime?      @map("deleted_at")
  updatedAt DateTime       @default(now()) @updatedAt @map("updated_at")
  createdAt DateTime       @default(now()) @map("created_at")
  user_id   String
  post_id   String
  user      user           @relation("post_save_user", fields: [user_id], references: [id], onDelete: Cascade)
  post      community_post @relation("post_save_post", fields: [post_id], references: [id], onDelete: Cascade)

  @@unique([user_id, post_id])
  @@index([user_id, createdAt])
  @@index([post_id])
  @@map("post_saves")
}

model post_share {
  id          String          @id @default(cuid())
  deleted     Boolean         @default(false)
  deletedAt   DateTime?       @map("deleted_at")
  updatedAt   DateTime        @default(now()) @updatedAt @map("updated_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  user_id     String?
  device_id   String?
  post_id     String
  reply_id    String?
  target_type String          @default("post")
  channel     String          @default("web_share")
  user        user?           @relation("post_share_user", fields: [user_id], references: [id], onDelete: SetNull)
  post        community_post  @relation("post_share_post", fields: [post_id], references: [id], onDelete: Cascade)
  reply       post_reply?     @relation("post_share_reply", fields: [reply_id], references: [id], onDelete: Cascade)

  @@index([post_id, createdAt])
  @@index([reply_id, createdAt])
  @@index([user_id, createdAt])
  @@index([device_id, createdAt])
  @@map("post_shares")
}

model post_reply_save {
  id        String     @id @default(cuid())
  deleted   Boolean    @default(false)
  deletedAt DateTime?  @map("deleted_at")
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at")
  createdAt DateTime   @default(now()) @map("created_at")
  user_id   String
  reply_id  String
  user      user       @relation("post_reply_save_user", fields: [user_id], references: [id], onDelete: Cascade)
  reply     post_reply @relation("post_reply_save_reply", fields: [reply_id], references: [id], onDelete: Cascade)

  @@unique([user_id, reply_id])
  @@index([user_id, createdAt])
  @@index([reply_id])
  @@map("post_reply_saves")
}

model post_notification_mute {
  id        String         @id @default(cuid())
  deleted   Boolean        @default(false)
  deletedAt DateTime?      @map("deleted_at")
  updatedAt DateTime       @default(now()) @updatedAt @map("updated_at")
  createdAt DateTime       @default(now()) @map("created_at")
  user_id   String
  post_id   String
  user      user           @relation("post_notification_mute_user", fields: [user_id], references: [id], onDelete: Cascade)
  post      community_post @relation("post_notification_mute_post", fields: [post_id], references: [id], onDelete: Cascade)

  @@unique([user_id, post_id])
  @@index([post_id])
  @@map("post_notification_mutes")
}

model post_report {
  id          String         @id @default(cuid())
  deleted     Boolean        @default(false)
  deletedAt   DateTime?      @map("deleted_at")
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  post_id     String
  reply_id    String?
  target_type String         @default("post")
  target_id   String
  reporter_id String
  reason      String
  description String?
  status      String         @default("pendente")
  post        community_post @relation("post_report_post", fields: [post_id], references: [id], onDelete: Cascade)
  reply       post_reply?    @relation("post_report_reply", fields: [reply_id], references: [id], onDelete: Cascade)
  reporter    user           @relation("post_report_reporter", fields: [reporter_id], references: [id], onDelete: Cascade)

  @@unique([target_type, target_id, reporter_id])
  @@index([post_id, reply_id, reporter_id])
  @@index([target_type, target_id, status])
  @@index([status, createdAt])
  @@index([reporter_id, createdAt])
  @@map("post_reports")
}

model notification_subscription {
  id           String    @id @default(cuid())
  deleted      Boolean   @default(false)
  deletedAt    DateTime? @map("deleted_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  device_id    String?
  user_id      String
  subscription Json?
  user         user      @relation("notification_subscription_user", fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, device_id])
  @@map("notification_subscriptions")
}

model notification {
  id            String    @id @default(cuid())
  deleted       Boolean   @default(false)
  deletedAt     DateTime?
  updatedAt     DateTime  @default(now()) @updatedAt
  createdAt     DateTime  @default(now())
  user_id       String
  read          Boolean   @default(false)
  redirect      String?
  message_key   String
  message_props Json?
  user          user      @relation("notifications", fields: [user_id], references: [id])

  @@index([user_id])
  @@map("notifications")
}

model log__user {
  id        String    @id @default(cuid())
  deleted   Boolean   @default(false)
  deletedAt DateTime? @map("deleted_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  createdAt DateTime  @default(now()) @map("created_at")
  ref_id    String?
  action    String
  old       String?
  new       String?
  ref       user?     @relation("log__user_user", fields: [ref_id], references: [id], onDelete: Cascade)

  @@index([ref_id])
  @@map("log__users")
}
