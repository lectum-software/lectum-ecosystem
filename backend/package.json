{
  "name": "backend",
  "description": "Lectum backend",
  "main": "dist/index.js",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "scripts": {
    "dev": "prisma generate && tsx watch src/index.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && prisma generate && tsc && tsc-alias",
    "start": "node dist/index.js",
    "typecheck": "prisma generate && tsc --noEmit --pretty false",
    "biome:check": "biome check --error-on-warnings package.json tsconfig.json prisma.config.ts prisma src/@types src/config src/doc.ts src/external/limiter.ts src/external/prisma src/helpers src/index.ts src/infra src/interfaces src/main/notification src/main/server src/main/socket src/modules src/operations src/packages src/query src/utils",
    "biome:fix": "biome check --write package.json tsconfig.json prisma.config.ts prisma src/@types src/config src/doc.ts src/external/limiter.ts src/external/prisma src/helpers src/index.ts src/infra src/interfaces src/main/notification src/main/server src/main/socket src/modules src/operations src/packages src/query src/utils",
    "check": "pnpm biome:check && pnpm typecheck",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate-prod": "prisma migrate deploy",
    "db:push": "prisma db push",
    "gen:vapid": "npx web-push generate-vapid-keys",
    "subscription:grant": "tsx src/operations/subscriptions/grant-professional-subscription.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [],
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1059.0",
    "@babel/parser": "^7.29.7",
    "@babel/traverse": "^7.29.7",
    "@faker-js/faker": "^10.4.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@scalar/express-api-reference": "^0.9.20",
    "@types/passport": "^1.0.17",
    "argon2": "^0.44.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "helmet": "^8.2.0",
    "i18next": "^26.3.0",
    "i18next-fs-backend": "^2.6.6",
    "i18next-http-middleware": "^3.9.7",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.13.4",
    "mercadopago": "^3.1.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.1",
    "nodemailer-express-handlebars": "^7.0.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.21.0",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^6.0.2",
    "uuid": "^14.0.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@prisma/internals": "^7.8.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.1",
    "@types/nodemailer": "^8.0.1",
    "@types/nodemailer-express-handlebars": "^4.0.6",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/web-push": "^3.6.4",
    "prisma": "^7.8.0",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.22.4",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": "1.19.13",
      "form-data": "4.0.6",
      "hono": "4.12.27",
      "ws": "8.21.0"
    }
  }
}
