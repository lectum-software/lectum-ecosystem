{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "json": {
    "formatter": {
      "enabled": true,
      "trailingCommas": "none"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        "noExplicitAny": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/packages/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noEmptyPattern": "off",
            "noUnusedFunctionParameters": "off",
            "noUnusedImports": "off",
            "noUnusedVariables": "off",
            "useParseIntRadix": "off"
          },
          "complexity": {
            "noImportantStyles": "off",
            "useOptionalChain": "off"
          },
          "style": {
            "noDescendingSpecificity": "off",
            "useImportType": "off"
          },
          "suspicious": {
            "noDuplicateProperties": "off",
            "noImplicitAnyLet": "off",
            "noTsIgnore": "off"
          }
        }
      }
    }
  ]
}
