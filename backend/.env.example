# =============================================================================
# Lectum backend - variaveis realmente referenciadas
# =============================================================================
# Este arquivo cobre as envs usadas pelo backend/ e pelo orquestrador local
# scripts/dev.mjs quando ele le backend/.env. Valores vazios indicam credenciais
# externas opcionais ou obrigatorias apenas para o fluxo correspondente.
# Em homologacao/producao, altere primeiro a aplicacao da branch `homolog` e
# confirme o deploy antes de repetir na `main`. Nunca remova uma env em uso no
# mesmo deploy em que o codigo deixa de le-la.

# -----------------------------------------------------------------------------
# Servidor/API
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
BASE=http://localhost:3001
# Origens liberadas para CORS, OAuth redirects, tracking e links de e-mail.
# Separe multiplas origens por virgula.
WEB_URL=http://localhost:3000,http://localhost:3002
# Opcional: origem extra do frontend usada no tracking publico.
FRONTEND_URL=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lectum
# 0/false para acesso direto; 1 quando a API estiver atras de proxy/load balancer.
TRUST_PROXY=0
# Limite do corpo JSON/urlencoded aceito pelo Express. Possui fallback seguro.
HTTP_BODY_LIMIT=1mb

# -----------------------------------------------------------------------------
# Observabilidade Sentry (opcional; sem DSN o backend permanece funcional)
# -----------------------------------------------------------------------------
# Para habilitar o envio, configure DSN e environment explicitamente.
# DSN HTTPS do projeto Node. Nunca exponha este valor em logs ou no frontend.
SENTRY_DSN=
# Obrigatório junto ao DSN; não usa fallback de NODE_ENV (por exemplo: homolog ou production).
SENTRY_ENVIRONMENT=

# -----------------------------------------------------------------------------
# Orquestrador local da raiz: pnpm dev
# -----------------------------------------------------------------------------
FRONTEND_PORT=3000
DEV_ADMIN_ENABLED=true
ADMIN_PORT=3002
DEV_BACKEND_READY_TIMEOUT_MS=90000

# Quando 1, pnpm dev inicia o provider abaixo apontando para o proxy local
# DEV_TUNNEL_PROXY_PORT. Use para testar Google OAuth/Mercado Pago com HTTPS publico.
DEV_TUNNEL_ENABLED=0
# Valores aceitos: cloudflared ou ngrok.
DEV_TUNNEL_PROVIDER=cloudflared
DEV_TUNNEL_PROXY_PORT=3005
# Opcional. Para URL fixa, configure um Cloudflare Named Tunnel externo e informe o nome abaixo.
DEV_TUNNEL_NAME=
# Opcional. URL publica esperada do Cloudflare Named Tunnel ou ngrok Dev Domain.
DEV_TUNNEL_URL=

# -----------------------------------------------------------------------------
# Auth/JWT e codigos de conta
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=change-me-with-a-strong-32-characters-minimum-secret
ADMIN_JWT_SECRET=change-me-with-a-different-strong-admin-secret
TOKEN_API_USER_MAX=5
# Validade maxima de JWTs novos e antigos. Fallback: 168h para usuario.
TOKEN_API_USER_TTL_HOURS=168
TOKEN_API_ADMIN_MAX=5
# Fallback: 12h para administrador.
TOKEN_API_ADMIN_TTL_HOURS=12
CODE_API_USER_VALID_MINUTES=15
RECOVERY_URL=/auth/reset-password
# Vazio usa bcrypt; use argon para habilitar Argon2 nos novos hashes.
CRYPTO_ALGORITHM=

# -----------------------------------------------------------------------------
# Rate limit
# -----------------------------------------------------------------------------
RATE_LIMIT_RETRIES=120
RATE_LIMIT_TIME=15
# Limita memoria usada pelo rate limiter em processo. Fallback: 50000 entradas.
RATE_LIMIT_STORE_MAX_ENTRIES=50000

# Revalida no banco tokens de sockets conectados e encerra sessoes revogadas.
# Fallback: 60000 ms; minimo aceito: 15000 ms.
SOCKET_AUTH_RECHECK_INTERVAL_MS=60000

# -----------------------------------------------------------------------------
# Google OAuth usuario API
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID_API_USER=
GOOGLE_CLIENT_SECRET_API_USER=
# Origem da API usada apenas no OAuth do Google. Quando vazio, usa BASE.
# Permite manter BASE/Mercado Pago em tunnel publico e testar login via localhost.
GOOGLE_OAUTH_BASE_URL=http://localhost:3001
CALLBACK_URL_API_USER=http://localhost:3000/auth/redirect
CALLBACK_FAIL_URL_API_USER=http://localhost:3000/auth/error

# -----------------------------------------------------------------------------
# E-mail transacional via Resend SMTP/Nodemailer
# -----------------------------------------------------------------------------
EMAIL_API_HOST=smtp.resend.com
EMAIL_API_PORT=465
EMAIL_API_SECURE=true
EMAIL_API_EMAIL=resend
EMAIL_API_KEY=
EMAIL_API_NAME=Lectum
EMAIL_API_SENDER=no-reply@example.com
EMAIL_API_UNSUBSCRIBE=unsubscribe@example.com
SYSTEM_NAME=Lectum
SYSTEM_LOGO=http://localhost:3001/logo.png

# -----------------------------------------------------------------------------
# Cloudflare R2 publico (uploads e arquivos publicos)
# -----------------------------------------------------------------------------
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_ACCESS_KEY_SECRET=
CLOUDFLARE_R2_PUBLIC_BUCKET_NAME=
# Quantidade maxima de uploads simultaneos por requisicao. Fallback: 2.
UPLOAD_MAX_CONCURRENCY=2
# Fila maxima de uploads aguardando slot. Fallback: 100.
UPLOAD_MAX_QUEUE_SIZE=100
# Limites individuais em MB. Todos sao opcionais e usam os fallbacks informados.
# Perfil profissional
UPLOAD_LIMIT_PSYCHOLOGIST_AVATAR_MB=5
UPLOAD_LIMIT_PSYCHOLOGIST_COVER_IMAGE_MB=5
UPLOAD_LIMIT_PSYCHOLOGIST_VIDEO_SIMPLE_MB=50
UPLOAD_LIMIT_PSYCHOLOGIST_VIDEO_MULTIPART_MB=300
UPLOAD_LIMIT_PSYCHOLOGIST_VIDEO_MULTIPART_CHUNK_MB=10
UPLOAD_LIMIT_PSYCHOLOGIST_VIDEO_COVER_MB=5
# Perfil do paciente
UPLOAD_LIMIT_PATIENT_AVATAR_MB=5
# Comunidades e respostas
UPLOAD_LIMIT_ADMIN_COMMUNITY_AVATAR_MB=5
UPLOAD_LIMIT_COMMUNITY_POST_MEDIA_MB=200
UPLOAD_LIMIT_COMMUNITY_POST_MEDIA_MULTIPART_MB=200
UPLOAD_LIMIT_POST_REPLY_MEDIA_SIMPLE_MB=200
UPLOAD_LIMIT_POST_REPLY_MEDIA_MULTIPART_MB=200
UPLOAD_LIMIT_POST_REPLY_MEDIA_MULTIPART_CHUNK_MB=10
# SEO administrativo
UPLOAD_LIMIT_ADMIN_SEO_OG_IMAGE_MB=5

# -----------------------------------------------------------------------------
# Cloudflare Stream privado (videos; rollout opt-in)
# -----------------------------------------------------------------------------
# Mantenha false ate concluir migration, credenciais, signing key e webhook.
CLOUDFLARE_STREAM_ENABLED=false
# Account ID da conta Cloudflare com Stream habilitado.
CLOUDFLARE_STREAM_ACCOUNT_ID=
# Segredo backend-only com permissao minima Stream Write.
CLOUDFLARE_STREAM_API_TOKEN=
# Customer code exibido na pagina Stream da conta; nao e o Account ID.
CLOUDFLARE_STREAM_CUSTOMER_CODE=
# ID e PEM base64 retornados uma unica vez por POST /stream/keys.
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
CLOUDFLARE_STREAM_SIGNING_PRIVATE_KEY_BASE64=
# Segredo retornado ao criar/consultar o unico webhook Stream da conta.
CLOUDFLARE_STREAM_WEBHOOK_SECRET=
# Origens HTTPS que podem consumir manifests/segmentos, separadas por virgula.
# Em homolog: frontend e admin de homologacao. Nunca use *.
CLOUDFLARE_STREAM_ALLOWED_ORIGINS=
# Opcionais; os fallbacks seguros sao 30min, 15s, 2h e 10min.
CLOUDFLARE_STREAM_PLAYBACK_TTL_SECONDS=1800
CLOUDFLARE_STREAM_REQUEST_TIMEOUT_MS=15000
CLOUDFLARE_STREAM_UPLOAD_EXPIRY_SECONDS=7200
CLOUDFLARE_STREAM_MAX_DURATION_SECONDS=600

# -----------------------------------------------------------------------------
# Serviço privado de processamento de vídeo (backend -> app video/)
# -----------------------------------------------------------------------------
# O backend continua funcional sem estas variáveis. Em ambiente publicado, use somente a origem
# privada do túnel/rede interna, nunca IP público ou domínio exposto à internet.
VIDEO_PROCESSING_SERVICE_URL=
# Mesmo segredo backend-only cadastrado como VIDEO_SERVICE_API_KEY na aplicação video/.
VIDEO_SERVICE_API_KEY=
# Opcional; fallback seguro de 5 segundos, limitado entre 500 e 30000 ms.
VIDEO_PROCESSING_SERVICE_REQUEST_TIMEOUT_MS=5000

# Limpeza de artefatos sociais legados. Manter durante o rollout enquanto existirem objetos
# temporários criados por versões anteriores; os defaults são seguros e a flag é opcional.
POST_SHARE_ARTIFACT_CLEANUP_ENABLED=true
POST_SHARE_ARTIFACT_CLEANUP_INTERVAL_MS=21600000
POST_SHARE_ARTIFACT_CLEANUP_BATCH_SIZE=50

# -----------------------------------------------------------------------------
# InfoSimples / validacao documental CFP
# -----------------------------------------------------------------------------
DOCUMENT_TOKEN=
# Tempo maximo para consultas documentais externas em ms. A consulta CFP pode levar mais de 20s.
DOCUMENT_REQUEST_TIMEOUT_MS=90000
# Logs sanitizados para diagnosticar consulta CFP/InfoSimples. Use false para desativar.
CFP_PROVIDER_LOGS=true

# -----------------------------------------------------------------------------
# Twilio SMS/WhatsApp verification
# -----------------------------------------------------------------------------
TWILIO_API_ACCOUNT_SID=
TWILIO_API_AUTH_TOKEN=
TWILIO_API_PHONE_NUMBER=
# Opcional: use Messaging Service em vez de sender direto.
TWILIO_API_MESSAGING_SERVICE_SID=

# -----------------------------------------------------------------------------
# Web Push
# -----------------------------------------------------------------------------
VAPID_EMAIL=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# Mercado Pago billing
# -----------------------------------------------------------------------------
# Assinaturas com plano associado em dev/homolog usam o Access Token APP_USR-* da
# aplicacao criada DENTRO de uma conta Mercado Pago vendedora de teste.
# O backend valida /users/me e bloqueia conta real quando MERCADO_PAGO_ENV=sandbox.
MERCADO_PAGO_ACCESS_TOKEN=
# Como a aplicacao da conta vendedora de teste usa APP_USR-*, configure o webhook na
# aba "Modo de producao" DESSA aplicacao de teste e copie a assinatura secreta daqui.
MERCADO_PAGO_WEBHOOK_SECRET=
# sandbox = ambiente Lectum sem dinheiro real; production/prod = conta vendedora real.
MERCADO_PAGO_ENV=sandbox
# URL HTTPS publica do frontend. Em homolog, use a rota canonica abaixo; em dev local,
# substitua o host por um tunnel HTTPS fixo.
MERCADO_PAGO_BACK_URL=https://homolog.lectum.com.br/app/profissional/assinatura/endereco
# Obrigatorio em sandbox: e-mail da conta Mercado Pago COMPRADORA de teste.
# Deve ser o mesmo valor de NEXT_PUBLIC_MERCADO_PAGO_SANDBOX_PAYER_EMAIL no frontend.
MERCADO_PAGO_SANDBOX_PAYER_EMAIL=
# Opcional: id de /preapproval_plan ja criado no Mercado Pago. Se vazio, o backend cria
# e persiste um plano no Mercado Pago a partir do plano ativo no banco.
MERCADO_PAGO_PREAPPROVAL_PLAN_ID=

# -----------------------------------------------------------------------------
# Analytics/geolocation opcional
# -----------------------------------------------------------------------------
IP_GEOLOCATION_PROVIDER=ipapi
IP_GEOLOCATION_ENDPOINT=https://ipapi.co/{ip}/json/
IP_GEOLOCATION_TOKEN=
IP_GEOLOCATION_TIMEOUT_MS=2500

# -----------------------------------------------------------------------------
# Notificacoes/digests opcionais
# -----------------------------------------------------------------------------
NOTIFICATION_DIGESTS_ENABLED=true
NOTIFICATION_DIGESTS_INTERVAL_MS=
# O scheduler de campanhas permanece desligado por padrao para impedir disparos
# inesperados de registros antigos. Antes de ativar, revise campanhas agendadas
# em homologacao e depois configure a mesma decisao em producao.
NOTIFICATION_CAMPAIGNS_SCHEDULER_ENABLED=false
NOTIFICATION_CAMPAIGNS_INTERVAL_MS=60000
NOTIFICATION_CAMPAIGNS_BATCH_SIZE=25
# Regua de cobranca: permanece desligada por padrao para evitar downgrades
# automaticos antes da validacao operacional em homologacao.
BILLING_DUNNING_SCHEDULER_ENABLED=false
BILLING_DUNNING_INTERVAL_MS=60000
BILLING_DUNNING_BATCH_SIZE=50

# -----------------------------------------------------------------------------
# Docs Swagger/Scalar
# -----------------------------------------------------------------------------
DOCS_MODE=false
SWAGGER=false
SWAGGER_DEBUG=false

# -----------------------------------------------------------------------------
# Docker/runtime deploy
# -----------------------------------------------------------------------------
# Quando true/1, o container Docker aplica `prisma migrate deploy` antes de iniciar a API.
RUN_DB_MIGRATIONS=true

# -----------------------------------------------------------------------------
# Reset seguro de banco local: backend/scripts/reset-database.mjs
# -----------------------------------------------------------------------------
LECTUM_CONFIRM_DB_RESET=0
# Obrigatório se o bucket não contiver marcador dev/local/test/sandbox/ci.
LECTUM_RESET_R2_PREFIX=dev/local-reset/
LECTUM_RESET_MERCADO_PAGO_SEARCH_QUERY=Plano Profissional
LECTUM_RESET_MERCADO_PAGO_STATUSES=authorized,pending,paused
