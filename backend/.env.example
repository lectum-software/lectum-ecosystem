NODE_ENV=development
PORT=3002
BASE=http://localhost:3002
WEB_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lectum

# InfoSimples document/professional registry validation (backend-only)
DOCUMENT_TOKEN=

# Twilio SMS verification (backend-only)
TWILIO_API_ACCOUNT_SID=
TWILIO_API_AUTH_TOKEN=
TWILIO_API_PHONE_NUMBER=
# Optional: use a Twilio Messaging Service instead of a direct sender number.
TWILIO_API_MESSAGING_SERVICE_SID=

# Mercado Pago billing (backend-only)
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_ENV=sandbox
# Public URL Mercado Pago can redirect to after plan/checkout flows.
# Required when creating a /preapproval_plan; localhost is rejected by Mercado Pago.
MERCADO_PAGO_BACK_URL=
# Optional: existing Mercado Pago /preapproval_plan id. When empty, backend creates
# and persists the plan during the first professional checkout.
MERCADO_PAGO_PREAPPROVAL_PLAN_ID=
# Optional sandbox payer account e-mail from Mercado Pago test users.
MERCADO_PAGO_TEST_PAYER_EMAIL=
