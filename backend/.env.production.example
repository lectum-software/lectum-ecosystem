# =============================================================================
# LECTUM BACKEND — DOKPLOY PRODUCAO
# =============================================================================
# MODELO: substitua TODOS os YOUR_OWN_... ativos ANTES de salvar no Dokploy.
# Nenhum placeholder e credencial valida. Nao enviar este arquivo preenchido ao Git.
# Copiar o conteudo para Environment da aplicacao BACKEND de PRODUCAO no Dokploy.
# Nao colocar segredos em Build-time Arguments (PORT=3001 basta, se necessario).
# .env.production NAO e carregado automaticamente pelo backend; o Dokploy injeta
# as variaveis no container. Nao alterar o start nem passar --env-file neste modelo.
# Nao copiar recursos/credenciais de homolog. Manter segredos de producao ja validos:
# trocar JWT revoga sessoes, VAPID invalida inscricoes e signing key afeta playback.
# Nao fazer deploy enquanto houver placeholders ou dependencias nao provisionadas.

# --- Servidor e banco ---------------------------------------------------------
NODE_ENV=production
PORT=3001
BASE=https://api.lectum.com.br
WEB_URL=https://lectum.com.br,https://admin.lectum.com.br
FRONTEND_URL=https://lectum.com.br
# URL PostgreSQL do banco de PRODUCAO, acessivel pelo container backend.
# Usar credencial restrita ao banco e codificar caracteres especiais da URL.
DATABASE_URL=YOUR_OWN_PRODUCTION_DATABASE_URL
# Apenas prisma migrate deploy, nunca reset/seed/backfill R2 no start.
RUN_DB_MIGRATIONS=true
# Um proxy confiavel entre cliente e API. Conferir topologia real no Dokploy/CF;
# nao usar true indiscriminadamente nem expor diretamente a porta 3001 na Internet.
TRUST_PROXY=1
HTTP_BODY_LIMIT=1mb

# --- Autenticacao -------------------------------------------------------------
# Segredos diferentes entre usuario/admin e entre homolog/producao.
# Usar pelo menos 32 bytes aleatorios; nunca o literal YOUR_OWN_... como segredo.
JWT_SECRET_KEY=YOUR_OWN_PRODUCTION_USER_JWT_SECRET
ADMIN_JWT_SECRET=YOUR_OWN_PRODUCTION_ADMIN_JWT_SECRET
TOKEN_API_USER_MAX=5
TOKEN_API_USER_TTL_HOURS=168
TOKEN_API_ADMIN_MAX=5
TOKEN_API_ADMIN_TTL_HOURS=12
CODE_API_USER_VALID_MINUTES=15
RECOVERY_URL=/auth/reset-password
# Vazio preserva o comportamento atual (bcrypt/Argon2 conforme tamanho da senha).
CRYPTO_ALGORITHM=

# --- Protecoes de requisicoes e sockets --------------------------------------
# Preserva a configuracao informada em homolog; rotas sensiveis tem limites proprios.
RATE_LIMIT_RETRIES=1000
RATE_LIMIT_TIME=15
RATE_LIMIT_STORE_MAX_ENTRIES=50000
SOCKET_AUTH_RECHECK_INTERVAL_MS=60000

# --- Google OAuth ------------------------------------------------------------
# Credenciais do cliente OAuth Web de producao.
# Cadastrar no Google: https://api.lectum.com.br/api/public/google/callback
# CALLBACK_URL_API_USER e o destino frontend, NAO o callback cadastrado no Google.
GOOGLE_CLIENT_ID_API_USER=YOUR_OWN_PRODUCTION_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET_API_USER=YOUR_OWN_PRODUCTION_GOOGLE_CLIENT_SECRET
GOOGLE_OAUTH_BASE_URL=https://api.lectum.com.br
CALLBACK_URL_API_USER=https://lectum.com.br/auth/redirect
CALLBACK_FAIL_URL_API_USER=https://lectum.com.br/auth/error

# --- E-mail transacional (Resend SMTP) ----------------------------------------
# Validar o dominio mail.lectum.com.br na conta Resend e o remetente autorizado.
EMAIL_API_HOST=smtp.resend.com
EMAIL_API_PORT=465
EMAIL_API_SECURE=true
EMAIL_API_EMAIL=resend
EMAIL_API_KEY=YOUR_OWN_PRODUCTION_RESEND_SMTP_KEY
EMAIL_API_NAME=Lectum
EMAIL_API_SENDER=notifications@mail.lectum.com.br
EMAIL_API_UNSUBSCRIBE=unsubscribe@mail.lectum.com.br
SYSTEM_NAME=Lectum
SYSTEM_LOGO=https://api.lectum.com.br/logo.png

# --- Imagens: Cloudflare R2 ---------------------------------------------------
# Endpoint S3 da conta, por exemplo https://ACCOUNT_ID.r2.cloudflarestorage.com.
# Nao usar o dominio publico de entrega como endpoint S3.
# Bucket de PRODUCAO, separado do bucket de homolog; permissao limitada ao bucket.
CLOUDFLARE_R2_ENDPOINT=YOUR_OWN_PRODUCTION_R2_S3_ENDPOINT
CLOUDFLARE_R2_ACCESS_KEY_ID=YOUR_OWN_PRODUCTION_R2_ACCESS_KEY_ID
CLOUDFLARE_R2_ACCESS_KEY_SECRET=YOUR_OWN_PRODUCTION_R2_ACCESS_KEY_SECRET
CLOUDFLARE_R2_PUBLIC_BUCKET_NAME=YOUR_OWN_PRODUCTION_R2_PUBLIC_BUCKET_NAME
UPLOAD_MAX_CONCURRENCY=2
UPLOAD_MAX_QUEUE_SIZE=100

# Imagens de perfil/comunidades/SEO (MB).
UPLOAD_LIMIT_PSYCHOLOGIST_AVATAR_MB=5
UPLOAD_LIMIT_PSYCHOLOGIST_COVER_IMAGE_MB=5
UPLOAD_LIMIT_PSYCHOLOGIST_VIDEO_COVER_MB=5
UPLOAD_LIMIT_PATIENT_AVATAR_MB=5
UPLOAD_LIMIT_ADMIN_COMMUNITY_AVATAR_MB=5
UPLOAD_LIMIT_ADMIN_SEO_OG_IMAGE_MB=5
# Midias de post e resposta: limites ainda consumidos em rotas compativeis.
# Estas chaves NAO autorizam novos videos no R2.
UPLOAD_LIMIT_COMMUNITY_POST_MEDIA_MB=200
UPLOAD_LIMIT_POST_REPLY_MEDIA_SIMPLE_MB=200
UPLOAD_LIMIT_POST_REPLY_MEDIA_MULTIPART_CHUNK_MB=10
# Limite TOTAL de video enviado diretamente ao Stream, por finalidade (MB).
# Nomes MULTIPART sao contratos atuais de configuracao, nao um destino R2.
UPLOAD_LIMIT_PSYCHOLOGIST_VIDEO_MULTIPART_MB=1000
UPLOAD_LIMIT_COMMUNITY_POST_MEDIA_MULTIPART_MB=1000
UPLOAD_LIMIT_POST_REPLY_MEDIA_MULTIPART_MB=1000

# --- Videos: Cloudflare Stream -----------------------------------------------
# Obrigatorio para videos publicados. Sem fallback de novos videos para R2.
CLOUDFLARE_STREAM_ENABLED=true
CLOUDFLARE_STREAM_ACCOUNT_ID=YOUR_OWN_PRODUCTION_STREAM_ACCOUNT_ID
CLOUDFLARE_STREAM_API_TOKEN=YOUR_OWN_PRODUCTION_STREAM_API_TOKEN
# Somente o customer code: sem "customer-", URL ou .cloudflarestream.com.
CLOUDFLARE_STREAM_CUSTOMER_CODE=YOUR_OWN_PRODUCTION_STREAM_CUSTOMER_CODE
CLOUDFLARE_STREAM_SIGNING_KEY_ID=YOUR_OWN_PRODUCTION_STREAM_SIGNING_KEY_ID
# Base64 do PEM RSA da chave privada de assinatura; uma unica linha.
CLOUDFLARE_STREAM_SIGNING_PRIVATE_KEY_BASE64=YOUR_OWN_PRODUCTION_STREAM_SIGNING_PRIVATE_KEY_BASE64
# Retornado pela API Cloudflare ao criar/consultar o webhook, NAO inventar segredo.
# Stream permite apenas UM webhook por conta. Se homolog e producao compartilham a conta,
# o destino unico deve ser o Worker:
# https://stream-webhook.lectum.com.br/cloudflare-stream
# Ver cloudflare/stream-webhook-router/README.md. O mesmo segredo precisa estar no
# Worker e nos backends que receberao eventos; nunca o versionar ou logar.
# https://developers.cloudflare.com/stream/manage-video-library/using-webhooks/#limitations
CLOUDFLARE_STREAM_WEBHOOK_SECRET=YOUR_OWN_PRODUCTION_STREAM_WEBHOOK_SECRET
# CSV simples, SEM colchetes JSON, aspas internas, barra final ou wildcard.
CLOUDFLARE_STREAM_ALLOWED_ORIGINS=https://lectum.com.br,https://admin.lectum.com.br
CLOUDFLARE_STREAM_PLAYBACK_TTL_SECONDS=1800
CLOUDFLARE_STREAM_REQUEST_TIMEOUT_MS=15000
CLOUDFLARE_STREAM_UPLOAD_EXPIRY_SECONDS=7200
CLOUDFLARE_STREAM_MAX_DURATION_SECONDS=600

# --- Processamento no servidor dedicado de video -----------------------------
# URL PRIVADA da instancia de PRODUCAO (ex.: http://IP_WIREGUARD:PORTA).
# Nao apontar automaticamente para a instancia/Redis/volume usados em homolog.
# Producao precisa de fila e armazenamento isolados, mesmo se compartilhar maquina.
# O backend chama a API privada; Redis/FFmpeg e configuracoes do worker ficam no video/.
VIDEO_PROCESSING_SERVICE_URL=YOUR_OWN_PRODUCTION_VIDEO_SERVICE_PRIVATE_URL
# Deve ser exatamente o VIDEO_SERVICE_API_KEY configurado na instancia video de producao.
VIDEO_SERVICE_API_KEY=YOUR_OWN_PRODUCTION_VIDEO_SERVICE_API_KEY
VIDEO_PROCESSING_SERVICE_REQUEST_TIMEOUT_MS=30000

# --- Validacao de registro CFP / InfoSimples ----------------------------------
DOCUMENT_TOKEN=YOUR_OWN_PRODUCTION_INFOSIMPLES_TOKEN
DOCUMENT_REQUEST_TIMEOUT_MS=90000
CFP_PROVIDER_LOGS=false

# --- Web Push ----------------------------------------------------------------
VAPID_EMAIL=mailto:tech@lectum.com.br
# Par correspondente de producao. Preservar o par existente se ha inscricoes reais.
VAPID_PUBLIC_KEY=YOUR_OWN_PRODUCTION_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_OWN_PRODUCTION_VAPID_PRIVATE_KEY

# --- Mercado Pago: conta vendedora REAL ---------------------------------------
# Nao usar conta/token de teste nem email de comprador sandbox neste bloco.
# A chave publica de PRODUCAO do frontend ainda esta dummy: pagamentos reais
# NAO estao prontos ate configurar o par frontend/backend e validar o fluxo.
MERCADO_PAGO_ENV=production
MERCADO_PAGO_ACCESS_TOKEN=YOUR_OWN_PRODUCTION_MERCADO_PAGO_ACCESS_TOKEN
MERCADO_PAGO_WEBHOOK_SECRET=YOUR_OWN_PRODUCTION_MERCADO_PAGO_WEBHOOK_SECRET
MERCADO_PAGO_BACK_URL=https://lectum.com.br/app/profissional/assinatura/endereco
# Opcional: manter vazio para criar/persistir plano a partir do plano ativo no banco.
# Se reutilizar plano externo, deve pertencer a MESMA conta vendedora real.
# Exemplo: MERCADO_PAGO_PREAPPROVAL_PLAN_ID=YOUR_OWN_PRODUCTION_PREAPPROVAL_PLAN_ID
MERCADO_PAGO_PREAPPROVAL_PLAN_ID=

# --- Analytics ---------------------------------------------------------------
IP_GEOLOCATION_PROVIDER=ipapi
IP_GEOLOCATION_ENDPOINT=https://ipapi.co/{ip}/json/
IP_GEOLOCATION_TIMEOUT_MS=2500
# Opcional: apenas se o contrato do endpoint geolocation escolhido exigir token.
# IP_GEOLOCATION_TOKEN=YOUR_OWN_PRODUCTION_GEOLOCATION_TOKEN

# --- Jobs do backend ---------------------------------------------------------
NOTIFICATION_DIGESTS_ENABLED=true
NOTIFICATION_DIGESTS_INTERVAL_MS=600000
# Nao ativar campanhas ou cobranca automatica antes de revisar dados e homologar.
NOTIFICATION_CAMPAIGNS_SCHEDULER_ENABLED=false
NOTIFICATION_CAMPAIGNS_INTERVAL_MS=60000
NOTIFICATION_CAMPAIGNS_BATCH_SIZE=25
BILLING_DUNNING_SCHEDULER_ENABLED=false
BILLING_DUNNING_INTERVAL_MS=60000
BILLING_DUNNING_BATCH_SIZE=50

# --- Documentacao tecnica: desabilitada no ambiente publicado -----------------
DOCS_MODE=false
SWAGGER=false
SWAGGER_DEBUG=false

# --- Observabilidade OPCIONAL: GlitchTip/Sentry -------------------------------
# Aceita somente DSN HTTPS do projeto backend em glit.lectum.com.br ou Sentry SaaS.
# Nao inserir DSN de frontend/admin, host parecido, porta, query ou segredo em logs.
# Sem DSN/environment valido a API inicia, mas NAO envia erros ao provider.
# Descomentar AMBAS as linhas somente apos provisionar o projeto backend de producao:
# SENTRY_DSN=YOUR_OWN_PRODUCTION_BACKEND_GLITCHTIP_DSN
# SENTRY_ENVIRONMENT=production
# Depois do deploy revisado, validar manualmente no container:
# node --enable-source-maps dist/operations/observability/check-observability.js --confirm=production

# --- Twilio SMS: OPCIONAL, desligado ate provisionar --------------------------
# Necessario se for habilitar verificacao por SMS. Deixar comentado se nao usar;
# o fluxo SMS ficara indisponivel, sem simular envio/verificacao.
# Configurar SID + token + UM remetente (phone OU messaging service).
# TWILIO_API_ACCOUNT_SID=YOUR_OWN_PRODUCTION_TWILIO_ACCOUNT_SID
# TWILIO_API_AUTH_TOKEN=YOUR_OWN_PRODUCTION_TWILIO_AUTH_TOKEN
# TWILIO_API_PHONE_NUMBER=YOUR_OWN_PRODUCTION_TWILIO_PHONE_E164
# TWILIO_API_MESSAGING_SERVICE_SID=YOUR_OWN_PRODUCTION_TWILIO_MESSAGING_SERVICE_SID
